# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.output/
.vercel/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars

# Env & secrets
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Worktrees / agent state
# MetaObjects agent context — track the shared skills, keep the rest of .claude/ local
.claude/*
!.claude/skills/
.worktrees/
worker-configuration.d.ts
# MetaObjects agent context — track the always-on + manifest, keep other tool state local
/.metaobjects/*
!/.metaobjects/AGENTS.md
!/.metaobjects/CLAUDE.md
!/.metaobjects/.agent-context.json
# The gen-state MANIFEST is committed on purpose; the snapshot bodies are not.
# One hash per generated path is what lets `meta gen` tell "this is exactly what I
# wrote" from "somebody edited this" on a machine that never generated the output —
# without it a fresh clone or a CI runner refuses to overwrite rather than guess.
# The directory has to be un-excluded first: git will not descend into an excluded
# directory, so a negation under it can never apply.
!/.metaobjects/.gen-state/
/.metaobjects/.gen-state/*
!/.metaobjects/.gen-state/.hashes.json
