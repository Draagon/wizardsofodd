{
  "name": "wizardsofodd",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "gen:db": "meta gen",
    "verify:portraits": "tsx scripts/verify-portraits.ts",
    "verify": "npm run verify:portraits",
    "check": "npm run gen:db && npm run verify && tsc -b && vitest run",
    "build:web": "vite build",
    "predeploy": "npm run check && npm run build:web",
    "db:migrate:local": "wrangler d1 migrations apply wizardsofodd --local",
    "db:migrate:remote": "wrangler d1 migrations apply wizardsofodd --remote",
    "gen:assets": "tsx scripts/generate-assets.ts",
    "gen:favicons": "tsx scripts/generate-favicons.ts",
    "postinstall": "wrangler types",
    "demo:drift": "meta verify --templates --codegen --prompts data/templates"
  },
  "dependencies": {
    "@metaobjectsdev/cli": "^0.15.18",
    "@metaobjectsdev/codegen-ts": "^0.15.18",
    "@metaobjectsdev/render": "^0.15.18",
    "@metaobjectsdev/runtime-ts": "^0.15.18",
    "@metaobjectsdev/sdk": "^0.15.18",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.5.1",
    "hono": "^4.12.29",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@metaobjectsdev/metadata": "^0.15.18",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "ts-poet": "^6.12.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.7",
    "wrangler": "^4.105.0"
  }
}
