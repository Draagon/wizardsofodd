{
  "name": "wizardsofodd",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "gen:db": "meta gen",
    "verify:portraits": "tsx scripts/verify-portraits.ts",
    "verify": "npm run verify:portraits",
    "check": "npm run gen:db && npm run verify && npm run verify:db && tsc -b && vitest run",
    "build:web": "vite build",
    "predeploy": "npm run check && npm run verify:db:remote && npm run build:web",
    "db:migrate:local": "wrangler d1 migrations apply wizardsofodd --local",
    "db:migrate:remote": "wrangler d1 migrations apply wizardsofodd --remote",
    "verify:db": "npm run db:migrate:local && meta verify --dialect d1 --d1 DB",
    "verify:db:remote": "meta verify --dialect d1 --d1 DB --remote",
    "gen:assets": "tsx scripts/generate-assets.ts",
    "gen:favicons": "tsx scripts/generate-favicons.ts",
    "postinstall": "wrangler types",
    "demo:drift": "meta verify --templates --codegen --prompts data/templates"
  },
  "dependencies": {
    "@metaobjectsdev/cli": "^0.20.11",
    "@metaobjectsdev/codegen-ts": "^0.20.3",
    "@metaobjectsdev/render": "^0.20.3",
    "@metaobjectsdev/runtime-ts": "^0.20.3",
    "@metaobjectsdev/sdk": "^0.20.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.5.1",
    "hono": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@metaobjectsdev/metadata": "^0.20.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "sharp": "^0.35.3",
    "ts-poet": "^6.12.0",
    "tsx": "^4.22.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.105.0"
  }
}
